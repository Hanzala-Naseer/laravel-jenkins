
pipeline {
    agent any

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Install Test Dependencies') {
            steps {
                sh '''
                    set -eu
                    php --version
                    composer --version
                    composer install --no-interaction --prefer-dist
                '''
            }
        }

        stage('Run Laravel Tests') {
            steps {
                sh '''
                    set -eu
                    test -f artisan
                    php artisan test
                '''
            }
        }
    }
}
