
pipeline {
    agent any

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Verify Deployment Configuration') {
            steps {
                sh '''
                    set -eu
                    test -f artisan
                    test -f composer.json
                    test -f composer.lock
                    echo "Deployment files verified."
                '''
            }
        }

        stage('Deploy to AWS EC2') {
            steps {
                sshagent(credentials: ['laravel-ec2-ssh']) {
                    sh '''
                        set -eu

                        DEPLOY_HOST="ubuntu@16.170.212.217"
                        DEPLOY_DIR="/home/ubuntu/laravel-jenkins"

                        ssh -o StrictHostKeyChecking=accept-new "$DEPLOY_HOST" \
                            "test -d '$DEPLOY_DIR'"

                        rsync -az --delete \
                            --exclude='.env' \
                            --exclude='.git/' \
                            --exclude='vendor/' \
                            --exclude='node_modules/' \
                            --exclude='storage/' \
                            --exclude='database/database.sqlite' \
                            --exclude='bootstrap/cache/*.php' \
                            -e "ssh -o StrictHostKeyChecking=accept-new" \
                            ./ "$DEPLOY_HOST:$DEPLOY_DIR/"

                        ssh "$DEPLOY_HOST" "
                            set -eu
                            cd '$DEPLOY_DIR'

                            composer install \
                                --no-dev \
                                --no-interaction \
                                --prefer-dist \
                                --optimize-autoloader

                            php artisan migrate --force
                            php artisan optimize:clear
                            php artisan config:cache
                            php artisan route:cache
                            php artisan view:cache

                            sudo chown -R ubuntu:www-data storage bootstrap/cache
                            sudo chmod -R ug+rwX storage bootstrap/cache

                            sudo nginx -t
                            sudo systemctl reload nginx

                            curl -fsS http://127.0.0.1/ > /dev/null

                            echo 'Laravel deployment completed successfully.'
                        "
                    '''
                }
            }
        }
    }
}
